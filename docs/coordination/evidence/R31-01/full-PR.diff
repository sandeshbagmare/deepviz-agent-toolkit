+++ b/.github/workflows/chart-contract.yml
@@ -0,0 +1,34 @@
+name: ChartSpec contract (focused slice)
+
+on:
+  push:
+    branches: [main, fix/r22-strict-numeric-contract]
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  numeric-contract:
+    name: Numeric contract / Python ${{ matrix.python }}
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python: ['3.11', '3.12', '3.13']
+    env:
+      PYTHONPATH: python/deepviz/src
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+      - name: Install contract-only test dependencies
+        run: python -m pip install 'pydantic>=2.10,<3' 'pytest>=8' 'jsonschema>=4.23' 'ruff>=0.11' 'mypy>=1.15'
+      - name: Full test suite present in this focused slice (not renderer integration)
+        run: python -m pytest -q --strict-markers --junitxml=contract-results.xml
+      - name: Lint focused source and tests
+        run: python -m ruff check .
+      - name: Type-check focused model
+        run: python -m mypy
