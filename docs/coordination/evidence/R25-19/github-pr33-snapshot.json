    "number": 30,
    "title": "Bug: Python chart schema coerces strings and booleans unlike JSON Schema",
    "html_url": "https://github.com/sandeshbagmare/deepviz-agent-toolkit/issues/30",
    "state": "open",
    "state_reason": null,
